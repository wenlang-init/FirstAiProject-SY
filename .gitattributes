# ==========================================================
# 换行符：gradlew 必须在 Linux/macOS CI 下也是 LF，否则会报 ^M
# ==========================================================
gradlew                text eol=lf
*.sh                   text eol=lf

# Windows 批处理保持 CRLF
*.bat                  text eol=crlf
*.cmd                  text eol=crlf

# ==========================================================
# 二进制：禁止转换换行、禁止生成文本差异
# ==========================================================
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.jar  binary
*.apk  binary
*.aab  binary
*.jks  binary
*.keystore binary
*.rar  binary
*.zip  binary

# ==========================================================
# 源码统一按文本处理（入库时归一成 LF）
# ==========================================================
*.kt        text
*.java      text
*.c         text
*.h         text
*.cpp       text
*.xml       text
*.gradle    text
*.kts       text
*.pro       text
*.properties text
